<%- include('includes/header.ejs') %>
<body>
    <h1>Quora Posts</h1>
    <% for(post of posts) { %>
        <div class="post">
            <h3 class="username">@<%= post.username %></h4>
            <h4 class="description"><%= post.description %></h4> 
            <a href="/posts/<%=post.id%>" class="detail">see in detail</a>
            <a href="/posts/edit/<%=post.id%>" class="edit">Edit Post</a><br>   
            <form method="post" action="/posts/<%=post.id%>?_method=DELETE">
                <button>Delete Post</button>
            </form>
        </div>
    <% } %>
    <a href="/posts/new">Write a new post</a> 
</body>
</html>
